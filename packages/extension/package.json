{
  "name": "zxcode-vscode",
  "displayName": "ZXCode",
  "description": "Authentic ZX Spectrum 48K BASIC with modern language tooling.",
  "version": "0.0.0",
  "publisher": "banyek",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/banyek/ZXCode.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:zx-spectrum-basic",
    "onDebug:zxcode-basic"
  ],
  "main": "./dist/extension.cjs",
  "files": [
    "dist",
    "syntaxes",
    "language-configuration.json",
    "README.md"
  ],
  "dependencies": {
    "@zxcode/core": "0.0.0",
    "@zxcode/runner": "0.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "zx-spectrum-basic",
        "aliases": [
          "ZX Spectrum BASIC",
          "Spectrum BASIC"
        ],
        "extensions": [
          ".zxbas"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zx-spectrum-basic",
        "scopeName": "source.zx-spectrum-basic",
        "path": "./syntaxes/zx-spectrum-basic.tmLanguage.json",
        "unbalancedBracketScopes": [
          "string.quoted.double.spectrum-basic",
          "comment.line.rem.spectrum-basic"
        ]
      }
    ],
    "commands": [
      {
        "command": "zxcode.check",
        "title": "ZXCode: Check BASIC"
      },
      {
        "command": "zxcode.build",
        "title": "ZXCode: Build TAP"
      },
      {
        "command": "zxcode.run",
        "title": "ZXCode: Run Spectrum",
        "icon": "$(play)"
      },
      {
        "command": "zxcode.stop",
        "title": "ZXCode: Stop Spectrum",
        "icon": "$(debug-stop)"
      },
      {
        "command": "zxcode.previewRenumber",
        "title": "ZXCode: Preview Renumber BASIC"
      },
      {
        "command": "zxcode.applyRenumber",
        "title": "ZXCode: Apply Renumber"
      },
      {
        "command": "zxcode.openProgram",
        "title": "ZXCode: Open BASIC Program"
      },
      {
        "command": "zxcode.debug",
        "title": "ZXCode: Debug Spectrum BASIC",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zxcode.check",
          "when": "editorLangId == zx-spectrum-basic",
          "group": "zxcode"
        },
        {
          "command": "zxcode.build",
          "when": "editorLangId == zx-spectrum-basic",
          "group": "zxcode"
        },
        {
          "command": "zxcode.run",
          "when": "editorLangId == zx-spectrum-basic",
          "group": "zxcode"
        },
        {
          "command": "zxcode.debug",
          "when": "editorLangId == zx-spectrum-basic",
          "group": "zxcode"
        }
      ],
      "editor/title": [
        {
          "command": "zxcode.run",
          "when": "editorLangId == zx-spectrum-basic",
          "group": "navigation@9"
        },
        {
          "command": "zxcode.stop",
          "when": "zxcode.running || zxcode.starting",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "ZXCode",
      "properties": {
        "zxcode.build.outputDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "TAP output subdirectory relative to the BASIC source directory. Empty writes beside the source. Use slash-separated names without dot segments or absolute paths."
        },
        "zxcode.target.profile": {
          "type": "string",
          "enum": [
            "spectrum-48k"
          ],
          "default": "spectrum-48k",
          "scope": "resource",
          "description": "Original ZX Spectrum 48K ROM BASIC. Other machines and dialects are not supported."
        },
        "zxcode.emulator.backend": {
          "type": "string",
          "enum": [
            "fuse"
          ],
          "default": "fuse",
          "scope": "resource",
          "description": "External emulator backend used by Run Spectrum."
        },
        "zxcode.emulator.executable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Absolute Fuse executable path on the extension host. Empty discovers Spectrum Fuse on PATH. Run requires workspace trust."
        },
        "zxcode.emulator.configurationFormat": {
          "type": "string",
          "enum": [
            "auto",
            "xml",
            "ini"
          ],
          "default": "auto",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Private Fuse configuration format. Auto uses the backend platform default; choose the format required by your Fuse build."
        },
        "zxcode.debug.executable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Absolute optional ZEsarUX 13.0 executable with the loopback-only option. Debugging requires workspace trust; normal Run uses Fuse independently."
        }
      }
    },
    "debuggers": [
      {
        "type": "zxcode-basic",
        "label": "ZXCode Spectrum BASIC",
        "languages": [
          "zx-spectrum-basic"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The independent Spectrum BASIC source document. Dirty editor text is compiled."
              },
              "zesaruxExecutable": {
                "type": "string",
                "description": "Optional absolute loopback-capable ZEsarUX executable, overriding zxcode.debug.executable."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop at the first verified BASIC statement."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zxcode-basic",
            "request": "launch",
            "name": "ZXCode: Debug BASIC",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ]
  }
}
