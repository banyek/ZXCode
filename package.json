{
  "name": "zxcode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/extension"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc --build && node scripts/build-extension.mjs",
    "clean": "tsc --build --clean && node scripts/build-extension.mjs --clean",
    "typecheck": "tsc --project packages/core/tsconfig.json --noEmit && tsc --project tsconfig.check.json && tsc --project packages/extension/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "zxcode": "node packages/cli/bin/zxcode.mjs",
    "test:compatibility": "npm run build && node scripts/compatibility/run-corpus.mjs",
    "test:service": "npm run build && node scripts/compatibility/run-service.mjs",
    "test:extension": "npm run build && node scripts/test-extension.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
