{
  "name": "zxcode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/core", "packages/cli"],
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --project packages/core/tsconfig.json --noEmit && tsc --project tsconfig.check.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "zxcode": "node packages/cli/bin/zxcode.mjs",
    "test:compatibility": "npm run build && node scripts/compatibility/run-corpus.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
